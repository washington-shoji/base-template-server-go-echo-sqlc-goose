PORT=8080
APP_ENV=development
LOG_LEVEL=DEBUG

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=app_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_MIGRATIONS_DIR=sql/migrations

ALLOWED_ORIGINS=*
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_BURST=50
RATE_LIMIT_USE_MEMORY=true
BODY_LIMIT=2M

AUTH_DISABLED=true
AUTH_SESSION_COOKIE=session_id
AUTH_SESSION_TTL=24h
AUTH_CSRF_COOKIE=csrf_token
AUTH_TOKEN_TTL=24h

METRICS_ENABLED=true
METRICS_PUBLIC=true
# METRICS_BASIC_AUTH_USER=
# METRICS_BASIC_AUTH_PASS=

JOBS_ENABLED=true
JOBS_EMBED_IN_SERVER=true
JOBS_POLL_INTERVAL=2s
JOBS_MAX_ATTEMPTS=5
REPORTS_PROCESSING_LEASE=5m
REPORTS_RECONCILE_AFTER=1m
REPORTS_RECONCILE_INTERVAL=30s

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s
